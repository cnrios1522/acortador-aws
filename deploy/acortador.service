[Unit]
Description=Acortador de enlaces FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/acortador-aws/backend
EnvironmentFile=/home/ubuntu/acortador-aws/backend/.env
ExecStart=/home/ubuntu/acortador-aws/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
